<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/gameplayRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/tabletop"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!--
      v1.6.3 reference composition canvas.
      GameActivity projects every major child from the approved 1672 x 941 master design
      into the current safe landscape window. Horizontal and vertical reference coordinates
      adapt independently so wide phones retain the approved board/HUD proportions.
    -->
    <FrameLayout
        android:id="@+id/gameplayCanvas"
        android:layout_width="1px"
        android:layout_height="1px"
        android:layout_gravity="center"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/playerOnePanel"
            android:layout_width="1px"
            android:layout_height="1px"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_panel_active">

            <ImageView
                android:id="@+id/playerOneCheckerIcon"
                android:layout_width="1px"
                android:layout_height="1px"
                android:scaleType="fitCenter"
                android:contentDescription="Player 1 checker" />

            <TextView
                android:id="@+id/playerOneName"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:text="You"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:fontFamily="serif"
                android:maxLines="1" />

            <View
                android:id="@+id/playerOneDivider"
                android:layout_width="1px"
                android:layout_height="1px"
                android:background="#8BC59A59" />

            <TextView
                android:id="@+id/playerOneScore"
                android:layout_width="1px"
                android:layout_height="1px"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="0"
                android:textColor="#FFE5A6"
                android:textStyle="bold"
                android:fontFamily="serif"
                android:background="@drawable/profile_avatar_bg" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/statusPanel"
            android:layout_width="1px"
            android:layout_height="1px"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/bg_status">

            <TextView
                android:id="@+id/statusLeftOrnament"
                android:layout_width="1px"
                android:layout_height="match_parent"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="✦"
                android:textColor="#E9C270" />

            <TextView
                android:id="@+id/statusTitle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="Roll to Decide First"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:fontFamily="serif"
                android:maxLines="1" />

            <TextView
                android:id="@+id/statusRightOrnament"
                android:layout_width="1px"
                android:layout_height="match_parent"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="✦"
                android:textColor="#E9C270" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/playerTwoPanel"
            android:layout_width="1px"
            android:layout_height="1px"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_panel">

            <TextView
                android:id="@+id/playerTwoScore"
                android:layout_width="1px"
                android:layout_height="1px"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="0"
                android:textColor="#FFE5A6"
                android:textStyle="bold"
                android:fontFamily="serif"
                android:background="@drawable/profile_avatar_bg" />

            <View
                android:id="@+id/playerTwoDivider"
                android:layout_width="1px"
                android:layout_height="1px"
                android:background="#8BC59A59" />

            <TextView
                android:id="@+id/playerTwoName"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical|right"
                android:includeFontPadding="false"
                android:text="AI"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:fontFamily="serif"
                android:maxLines="1" />

            <ImageView
                android:id="@+id/playerTwoCheckerIcon"
                android:layout_width="1px"
                android:layout_height="1px"
                android:scaleType="fitCenter"
                android:contentDescription="Player 2 checker" />
        </LinearLayout>

        <com.george.backgammon.rendering.BackgammonBoardView
            android:id="@+id/boardView"
            android:layout_width="1px"
            android:layout_height="1px"
            android:contentDescription="Backgammon board" />

        <Button
            android:id="@+id/undoButton"
            android:layout_width="1px"
            android:layout_height="1px"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:background="@drawable/button_dark"
            android:text="↶  Undo"
            android:textAllCaps="false"
            android:includeFontPadding="false"
            android:textColor="@color/button_text"
            android:fontFamily="serif"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/mainActionButton"
            android:layout_width="1px"
            android:layout_height="1px"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:background="@drawable/button_green"
            android:text="⚄  Opening Roll"
            android:textAllCaps="false"
            android:includeFontPadding="false"
            android:textColor="@color/button_text"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/menuButton"
            android:layout_width="1px"
            android:layout_height="1px"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:background="@drawable/button_dark"
            android:text="☰"
            android:textAllCaps="false"
            android:includeFontPadding="false"
            android:textColor="@color/button_text"
            android:fontFamily="sans"
            android:stateListAnimator="@null" />

    </FrameLayout>
</FrameLayout>
