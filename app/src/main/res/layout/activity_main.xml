<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="6dp"
    android:paddingTop="4dp"
    android:paddingRight="6dp"
    android:paddingBottom="4dp"
    android:background="@drawable/tabletop">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false">

        <LinearLayout
            android:id="@+id/playerOnePanel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingLeft="12dp"
            android:paddingRight="10dp"
            android:background="@drawable/bg_panel_active">

            <TextView
                android:id="@+id/playerOneName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="You"
                android:textColor="@color/text_primary"
                android:textSize="15.5sp"
                android:textStyle="bold"
                android:fontFamily="serif" />

            <TextView
                android:id="@+id/playerOneSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="IVORY • OFF 0 • BAR 0"
                android:textColor="@color/text_secondary"
                android:textSize="8.8sp"
                android:letterSpacing="0.04" />
        </LinearLayout>

        <Space android:layout_width="6dp" android:layout_height="1dp" />

        <TextView
            android:id="@+id/statusTitle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.72"
            android:gravity="center"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:background="@drawable/bg_status"
            android:text="Player 1 • Roll"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:maxLines="1"
            android:ellipsize="end" />

        <Space android:layout_width="6dp" android:layout_height="1dp" />

        <LinearLayout
            android:id="@+id/playerTwoPanel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical|right"
            android:paddingLeft="10dp"
            android:paddingRight="12dp"
            android:background="@drawable/bg_panel">

            <TextView
                android:id="@+id/playerTwoName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AI"
                android:textColor="@color/text_primary"
                android:textSize="15.5sp"
                android:textStyle="bold"
                android:fontFamily="serif" />

            <TextView
                android:id="@+id/playerTwoSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WALNUT • OFF 0 • BAR 0"
                android:textColor="@color/text_secondary"
                android:textSize="8.8sp"
                android:letterSpacing="0.04" />
        </LinearLayout>
    </LinearLayout>

    <Space android:layout_width="1dp" android:layout_height="3dp" />

    <com.george.backgammon.rendering.BackgammonBoardView
        android:id="@+id/boardView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:contentDescription="Backgammon board" />

    <Space android:layout_width="1dp" android:layout_height="3dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:baselineAligned="false">

        <Button
            android:id="@+id/undoButton"
            android:layout_width="58dp"
            android:layout_height="match_parent"
            android:background="@drawable/button_dark_selector"
            android:text="↶\nUndo"
            android:textAllCaps="false"
            android:textColor="@color/button_text"
            android:textSize="11sp"
            android:fontFamily="serif"
            android:stateListAnimator="@null" />

        <Space android:layout_width="8dp" android:layout_height="1dp" />

        <Button
            android:id="@+id/mainActionButton"
            android:layout_width="210dp"
            android:layout_height="match_parent"
            android:background="@drawable/button_green_selector"
            android:text="⚄  Roll Dice"
            android:textAllCaps="false"
            android:textColor="@color/button_text"
            android:textSize="16.5sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:stateListAnimator="@null" />

        <Space android:layout_width="8dp" android:layout_height="1dp" />

        <Button
            android:id="@+id/menuButton"
            android:layout_width="58dp"
            android:layout_height="match_parent"
            android:background="@drawable/button_dark_selector"
            android:text="☰"
            android:textAllCaps="false"
            android:textColor="@color/button_text"
            android:textSize="22sp"
            android:fontFamily="sans"
            android:stateListAnimator="@null" />
    </LinearLayout>
</LinearLayout>
