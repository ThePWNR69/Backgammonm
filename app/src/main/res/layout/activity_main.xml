<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/gameplayRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/tabletop"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!--
      v1.10.0 approved gameplay composition.
      All child geometry is placed by GameActivity against the single 510 x 280
      reference frame measured from the approved Classic Burgundy concept.
    -->
    <FrameLayout
        android:id="@+id/gameplayCanvas"
        android:layout_width="1px"
        android:layout_height="1px"
        android:layout_gravity="center"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/playerOnePanel"
            android:layout_width="1px"
            android:layout_height="1px"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/premium_player_left">

            <ImageView
                android:id="@+id/playerOneCheckerIcon"
                android:layout_width="1px"
                android:layout_height="1px"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:background="@drawable/hud_avatar_ring"
                android:src="@drawable/ic_profile"
                android:contentDescription="Player 1" />

            <TextView
                android:id="@+id/playerOneName"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:text="Player 1"
                android:textColor="#FFF5E5"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1" />

            <View
                android:id="@+id/playerOneDivider"
                android:layout_width="1px"
                android:layout_height="1px"
                android:background="@android:color/transparent" />

            <TextView
                android:id="@+id/playerOneScore"
                android:layout_width="1px"
                android:layout_height="1px"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="0"
                android:textColor="#FFF1CF"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:background="@android:color/transparent" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/statusPanel"
            android:layout_width="1px"
            android:layout_height="1px"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/premium_status">

            <TextView
                android:id="@+id/statusLeftOrnament"
                android:layout_width="1px"
                android:layout_height="match_parent"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="◆"
                android:textColor="#5A3514" />

            <TextView
                android:id="@+id/statusTitle"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="ROLL TO DECIDE FIRST"
                android:textColor="#2A180C"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1" />

            <TextView
                android:id="@+id/statusRightOrnament"
                android:layout_width="1px"
                android:layout_height="match_parent"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="◆"
                android:textColor="#5A3514" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/playerTwoPanel"
            android:layout_width="1px"
            android:layout_height="1px"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/premium_player_right">

            <TextView
                android:id="@+id/playerTwoScore"
                android:layout_width="1px"
                android:layout_height="1px"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="0"
                android:textColor="#FFF1CF"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:background="@android:color/transparent" />

            <View
                android:id="@+id/playerTwoDivider"
                android:layout_width="1px"
                android:layout_height="1px"
                android:background="@android:color/transparent" />

            <TextView
                android:id="@+id/playerTwoName"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical|right"
                android:includeFontPadding="false"
                android:text="AI - Normal"
                android:textColor="#FFF5E5"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1" />

            <ImageView
                android:id="@+id/playerTwoCheckerIcon"
                android:layout_width="1px"
                android:layout_height="1px"
                android:padding="5dp"
                android:scaleType="fitCenter"
                android:background="@drawable/hud_avatar_ring_ai"
                android:src="@drawable/ic_robot"
                android:tint="#5CB8FF"
                android:contentDescription="Player 2" />
        </LinearLayout>

        <Button
            android:id="@+id/menuButton"
            android:layout_width="1px"
            android:layout_height="1px"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:background="@drawable/premium_square_button_selector"
            android:text="☰"
            android:textAllCaps="false"
            android:includeFontPadding="false"
            android:textColor="#FFE9B6"
            android:fontFamily="sans-serif-medium"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/settingsButton"
            android:layout_width="1px"
            android:layout_height="1px"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:background="@drawable/premium_square_button_selector"
            android:text="⚙"
            android:textAllCaps="false"
            android:includeFontPadding="false"
            android:textColor="#FFE9B6"
            android:fontFamily="sans-serif-medium"
            android:stateListAnimator="@null" />

        <com.george.backgammon.rendering.BackgammonBoardView
            android:id="@+id/boardView"
            android:layout_width="1px"
            android:layout_height="1px"
            android:contentDescription="Backgammon board" />

        <View
            android:id="@+id/bottomControlBar"
            android:layout_width="1px"
            android:layout_height="1px"
            android:background="@drawable/premium_bottom_deck" />

        <ImageView
            android:id="@+id/dieOneView"
            android:layout_width="1px"
            android:layout_height="1px"
            android:scaleType="fitCenter"
            android:contentDescription="Die one" />

        <ImageView
            android:id="@+id/dieTwoView"
            android:layout_width="1px"
            android:layout_height="1px"
            android:scaleType="fitCenter"
            android:contentDescription="Die two" />

        <Button
            android:id="@+id/mainActionButton"
            android:layout_width="1px"
            android:layout_height="1px"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:background="@drawable/premium_primary_button_selector"
            android:text="⚄  ROLL"
            android:textAllCaps="false"
            android:includeFontPadding="false"
            android:textColor="#FFF2CF"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/undoButton"
            android:layout_width="1px"
            android:layout_height="1px"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:background="@drawable/premium_secondary_button_selector"
            android:text="↶  UNDO"
            android:textAllCaps="false"
            android:includeFontPadding="false"
            android:textColor="#FFE9B6"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/hintButton"
            android:layout_width="1px"
            android:layout_height="1px"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:background="@drawable/premium_secondary_button_selector"
            android:text="♧  HINT"
            android:textAllCaps="false"
            android:includeFontPadding="false"
            android:textColor="#FFE9B6"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:stateListAnimator="@null" />

    </FrameLayout>
</FrameLayout>
