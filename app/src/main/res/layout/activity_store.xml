<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/screen_green_background">

    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageButton android:id="@+id/backButton" android:layout_width="46dp" android:layout_height="42dp" android:padding="10dp" android:src="@drawable/ic_back" android:background="@drawable/premium_small_button" android:contentDescription="Back" />
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="STORE" android:textColor="#F4DEAF" android:textSize="24sp" android:textStyle="bold" android:fontFamily="serif" android:letterSpacing="0.08" />
        <LinearLayout android:layout_width="94dp" android:layout_height="38dp" android:orientation="horizontal" android:gravity="center" android:background="@drawable/coin_chip">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_coin" android:contentDescription="Coins" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="6dp" android:text="0" android:textColor="#F7E5BD" android:textSize="14sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="5dp" android:text="＋" android:textColor="#70C7A2" android:textSize="16sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="6dp" android:orientation="horizontal" android:gravity="center">
        <TextView android:layout_width="125dp" android:layout_height="38dp" android:gravity="center" android:text="Boards" android:textColor="#F8E5B5" android:textSize="13sp" android:textStyle="bold" android:background="@drawable/premium_tab_selected" />
        <Space android:layout_width="8dp" android:layout_height="1dp" />
        <TextView android:layout_width="125dp" android:layout_height="38dp" android:gravity="center" android:text="Checkers" android:textColor="#AFA081" android:textSize="13sp" android:background="@drawable/premium_tab" />
        <Space android:layout_width="8dp" android:layout_height="1dp" />
        <TextView android:layout_width="125dp" android:layout_height="38dp" android:gravity="center" android:text="Animations" android:textColor="#AFA081" android:textSize="13sp" android:background="@drawable/premium_tab" />
        <Space android:layout_width="8dp" android:layout_height="1dp" />
        <TextView android:layout_width="125dp" android:layout_height="38dp" android:gravity="center" android:text="Bundles" android:textColor="#AFA081" android:textSize="13sp" android:background="@drawable/premium_tab" />
    </LinearLayout>

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:gravity="center" android:text="A preview of the future cosmetic store — purchasing will be added with progression" android:textColor="#789989" android:textSize="9sp" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center" android:baselineAligned="false" android:layout_marginTop="10dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="5dp" android:padding="8dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/premium_card">
            <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/store_emerald" android:scaleType="centerCrop" android:contentDescription="Royal Emerald board" />
                <ImageView android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="top|end" android:layout_margin="8dp" android:src="@drawable/ic_lock" android:contentDescription="Locked" />
            </FrameLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:gravity="center" android:text="Royal Emerald" android:textColor="#FFF0D2" android:textSize="15sp" android:textStyle="bold" android:fontFamily="serif" />
            <TextView android:layout_width="match_parent" android:layout_height="32dp" android:layout_marginTop="5dp" android:gravity="center" android:text="COMING SOON" android:textColor="#E5C06F" android:textSize="9sp" android:textStyle="bold" android:background="@drawable/premium_small_button" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="5dp" android:padding="8dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/premium_card">
            <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/store_obsidian" android:scaleType="centerCrop" android:contentDescription="Obsidian Gold board" />
                <ImageView android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="top|end" android:layout_margin="8dp" android:src="@drawable/ic_lock" android:contentDescription="Locked" />
            </FrameLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:gravity="center" android:text="Obsidian Gold" android:textColor="#FFF0D2" android:textSize="15sp" android:textStyle="bold" android:fontFamily="serif" />
            <TextView android:layout_width="match_parent" android:layout_height="32dp" android:layout_marginTop="5dp" android:gravity="center" android:text="COMING SOON" android:textColor="#E5C06F" android:textSize="9sp" android:textStyle="bold" android:background="@drawable/premium_small_button" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="5dp" android:padding="8dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/premium_card">
            <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
                <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/store_sapphire" android:scaleType="centerCrop" android:contentDescription="Sapphire Marble board" />
                <ImageView android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="top|end" android:layout_margin="8dp" android:src="@drawable/ic_lock" android:contentDescription="Locked" />
            </FrameLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:gravity="center" android:text="Sapphire Marble" android:textColor="#FFF0D2" android:textSize="15sp" android:textStyle="bold" android:fontFamily="serif" />
            <TextView android:layout_width="match_parent" android:layout_height="32dp" android:layout_marginTop="5dp" android:gravity="center" android:text="COMING SOON" android:textColor="#E5C06F" android:textSize="9sp" android:textStyle="bold" android:background="@drawable/premium_small_button" />
        </LinearLayout>
    </LinearLayout>

    <TextView android:layout_width="match_parent" android:layout_height="34dp" android:gravity="center" android:text="More collections, boss sets and limited cosmetics will appear here" android:textColor="#607D70" android:textSize="8.5sp" android:letterSpacing="0.04" />
</LinearLayout>
