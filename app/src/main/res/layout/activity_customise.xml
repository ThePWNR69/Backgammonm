<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/screen_green_background">

    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageButton android:id="@+id/backButton" android:layout_width="46dp" android:layout_height="42dp" android:padding="10dp" android:src="@drawable/ic_back" android:background="@drawable/premium_small_button" android:contentDescription="Back" />
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="CUSTOMISE" android:textColor="#F4DEAF" android:textSize="24sp" android:textStyle="bold" android:fontFamily="serif" android:letterSpacing="0.08" />
        <Space android:layout_width="46dp" android:layout_height="1dp" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="46dp" android:orientation="horizontal" android:gravity="center" android:layout_marginTop="6dp">
        <TextView android:id="@+id/tabBoard" android:layout_width="160dp" android:layout_height="42dp" android:gravity="center" android:text="Board" android:textColor="#F8E5B5" android:textSize="15sp" android:textStyle="bold" android:fontFamily="serif" android:background="@drawable/premium_tab_selected" android:clickable="true" />
        <Space android:layout_width="10dp" android:layout_height="1dp" />
        <TextView android:id="@+id/tabCheckers" android:layout_width="160dp" android:layout_height="42dp" android:gravity="center" android:text="Checkers" android:textColor="#CDBA92" android:textSize="15sp" android:fontFamily="serif" android:background="@drawable/premium_tab" android:clickable="true" />
        <Space android:layout_width="10dp" android:layout_height="1dp" />
        <TextView android:id="@+id/tabAnimation" android:layout_width="160dp" android:layout_height="42dp" android:gravity="center" android:text="Animation" android:textColor="#CDBA92" android:textSize="15sp" android:fontFamily="serif" android:background="@drawable/premium_tab" android:clickable="true" />
    </LinearLayout>

    <TextView android:id="@+id/sectionDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:gravity="center" android:text="Choose the board that sets the tone of your table" android:textColor="#8FAE9E" android:textSize="9.5sp" />

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="10dp">

        <LinearLayout android:id="@+id/boardContent" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center" android:baselineAligned="false">
            <LinearLayout android:id="@+id/boardCard0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="5dp" android:padding="8dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/premium_card" android:clickable="true">
                <com.george.backgammon.rendering.CosmeticPreviewView android:id="@+id/boardPreview0" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:contentDescription="Classic Walnut preview" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:gravity="center" android:text="Classic Walnut" android:textColor="#FFF0D2" android:textSize="15sp" android:textStyle="bold" android:fontFamily="serif" />
                <TextView android:id="@+id/boardState0" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="" android:textColor="#EBC56E" android:textSize="9sp" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout android:id="@+id/boardCard1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="5dp" android:padding="8dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/premium_card" android:clickable="true">
                <com.george.backgammon.rendering.CosmeticPreviewView android:id="@+id/boardPreview1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:contentDescription="Aegean Marble preview" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:gravity="center" android:text="Aegean Marble" android:textColor="#FFF0D2" android:textSize="15sp" android:textStyle="bold" android:fontFamily="serif" />
                <TextView android:id="@+id/boardState1" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="" android:textColor="#EBC56E" android:textSize="9sp" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout android:id="@+id/boardCard2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="5dp" android:padding="8dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/premium_card" android:clickable="true">
                <com.george.backgammon.rendering.CosmeticPreviewView android:id="@+id/boardPreview2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:contentDescription="Midnight Teal preview" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:gravity="center" android:text="Midnight Teal" android:textColor="#FFF0D2" android:textSize="15sp" android:textStyle="bold" android:fontFamily="serif" />
                <TextView android:id="@+id/boardState2" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="" android:textColor="#EBC56E" android:textSize="9sp" android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:id="@+id/checkerContent" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center" android:baselineAligned="false" android:visibility="gone">
            <LinearLayout android:id="@+id/checkerCard0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="5dp" android:padding="8dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/premium_card" android:clickable="true">
                <com.george.backgammon.rendering.CosmeticPreviewView android:id="@+id/checkerPreview0" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:contentDescription="Ivory and Walnut preview" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:gravity="center" android:text="Ivory &amp; Walnut" android:textColor="#FFF0D2" android:textSize="15sp" android:textStyle="bold" android:fontFamily="serif" />
                <TextView android:id="@+id/checkerState0" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="" android:textColor="#EBC56E" android:textSize="9sp" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout android:id="@+id/checkerCard1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="5dp" android:padding="8dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/premium_card" android:clickable="true">
                <com.george.backgammon.rendering.CosmeticPreviewView android:id="@+id/checkerPreview1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:contentDescription="Marble and Bronze preview" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:gravity="center" android:text="Marble &amp; Bronze" android:textColor="#FFF0D2" android:textSize="15sp" android:textStyle="bold" android:fontFamily="serif" />
                <TextView android:id="@+id/checkerState1" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="" android:textColor="#EBC56E" android:textSize="9sp" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout android:id="@+id/checkerCard2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="5dp" android:padding="8dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/premium_card" android:clickable="true">
                <com.george.backgammon.rendering.CosmeticPreviewView android:id="@+id/checkerPreview2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:contentDescription="Obsidian and Gold preview" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:gravity="center" android:text="Obsidian &amp; Gold" android:textColor="#FFF0D2" android:textSize="15sp" android:textStyle="bold" android:fontFamily="serif" />
                <TextView android:id="@+id/checkerState2" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="" android:textColor="#EBC56E" android:textSize="9sp" android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:id="@+id/animationContent" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center" android:baselineAligned="false" android:visibility="gone">
            <LinearLayout android:id="@+id/animationCard0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="5dp" android:padding="8dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/premium_card" android:clickable="true">
                <TextView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:text="↝" android:textColor="#EFD59A" android:textSize="38sp" android:background="@drawable/bg_panel" android:contentDescription="Smooth Slide preview" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:gravity="center" android:text="Smooth Slide" android:textColor="#FFF0D2" android:textSize="15sp" android:textStyle="bold" android:fontFamily="serif" />
                <TextView android:id="@+id/animationState0" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="" android:textColor="#EBC56E" android:textSize="9sp" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout android:id="@+id/animationCard1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="5dp" android:padding="8dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/premium_card" android:clickable="true">
                <TextView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:text="⚡" android:textColor="#EFD59A" android:textSize="34sp" android:background="@drawable/bg_panel" android:contentDescription="Fast Snap preview" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:gravity="center" android:text="Fast Snap" android:textColor="#FFF0D2" android:textSize="15sp" android:textStyle="bold" android:fontFamily="serif" />
                <TextView android:id="@+id/animationState1" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="" android:textColor="#EBC56E" android:textSize="9sp" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout android:id="@+id/animationCard2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_margin="5dp" android:padding="8dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/premium_card" android:clickable="true">
                <TextView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:text="◉" android:textColor="#EFD59A" android:textSize="38sp" android:background="@drawable/bg_panel" android:contentDescription="Roll and Fall preview" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:gravity="center" android:text="Roll &amp; Fall" android:textColor="#FFF0D2" android:textSize="15sp" android:textStyle="bold" android:fontFamily="serif" />
                <TextView android:id="@+id/animationState2" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="" android:textColor="#EBC56E" android:textSize="9sp" android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <TextView android:layout_width="match_parent" android:layout_height="32dp" android:gravity="center" android:text="Tap a card to equip it instantly" android:textColor="#6E8E7F" android:textSize="8.5sp" android:letterSpacing="0.08" />
</LinearLayout>
