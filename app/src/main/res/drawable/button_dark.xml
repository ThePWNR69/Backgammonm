<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="2dp" android:left="2dp" android:right="2dp">
        <shape android:shape="rectangle"><corners android:radius="13dp"/><solid android:color="#55000000"/></shape>
    </item>
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="13dp"/>
            <gradient android:angle="270" android:startColor="#28231E" android:endColor="#151310"/>
            <stroke android:width="1dp" android:color="#8F6A39"/>
        </shape>
    </item>
</layer-list>
