<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="1dp" android:top="4dp" android:right="1dp">
        <shape android:shape="rectangle"><solid android:color="#92000000"/><corners android:radius="18dp"/></shape>
    </item>
    <item android:left="1dp" android:right="1dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#D9B06C" android:centerColor="#93642F" android:endColor="#543217"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>
    <item android:left="3dp" android:top="2dp" android:right="3dp" android:bottom="6dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#3A2418" android:centerColor="#24150E" android:endColor="#0F0906"/>
            <stroke android:width="1dp" android:color="#A67A43"/>
            <corners android:radius="14dp"/>
        </shape>
    </item>
</layer-list>
