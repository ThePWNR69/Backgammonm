<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="2dp">
        <shape android:shape="rectangle"><solid android:color="#79000000"/><corners android:radius="15dp"/></shape>
    </item>
    <item android:bottom="1dp">
        <shape android:shape="rectangle"><gradient android:angle="270" android:startColor="#E7C477" android:centerColor="#B07A32" android:endColor="#654018"/><corners android:radius="15dp"/></shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#3B271B" android:centerColor="#24150E" android:endColor="#120A07"/>
            <stroke android:width="1dp" android:color="#D7AE62"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>
</layer-list>
