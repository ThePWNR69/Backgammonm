<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="1dp" android:top="3dp" android:right="1dp">
        <shape android:shape="rectangle"><solid android:color="#98000000"/><corners android:radius="18dp"/></shape>
    </item>
    <item android:left="1dp" android:right="1dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#F8D88E" android:centerColor="#C4964D" android:endColor="#715022"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>
    <item android:left="3dp" android:top="2dp" android:right="3dp" android:bottom="5dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#44291B" android:centerColor="#26150E" android:endColor="#0F0906"/>
            <stroke android:width="2dp" android:color="#E8C579"/>
            <corners android:radius="15dp"/>
        </shape>
    </item>
</layer-list>
