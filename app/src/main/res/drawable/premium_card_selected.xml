<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="3dp"><shape android:shape="rectangle"><solid android:color="#8A000000"/><corners android:radius="16dp"/></shape></item>
    <item android:bottom="3dp"><shape android:shape="rectangle"><gradient android:angle="0" android:startColor="#6A401D" android:centerColor="#E4BD70" android:endColor="#6A401D"/><corners android:radius="16dp"/></shape></item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="5dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#174C3C" android:centerColor="#0D342A" android:endColor="#08231D"/>
            <stroke android:width="1.5dp" android:color="#F0D28A"/>
            <corners android:radius="13dp"/>
        </shape>
    </item>
</layer-list>
