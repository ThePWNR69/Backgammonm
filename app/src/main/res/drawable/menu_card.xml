<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="2dp" android:top="3dp" android:right="2dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#85000000" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#3B281B" android:centerColor="#21150F" android:endColor="#100A07" />
            <stroke android:width="1dp" android:color="#A9804E" />
            <corners android:radius="19dp" />
        </shape>
    </item>
</layer-list>
