<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="1dp">
        <shape android:shape="rectangle"><solid android:color="#55000000"/><corners android:radius="13dp"/></shape>
    </item>
    <item android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#332218" android:centerColor="#1C120D" android:endColor="#0F0906"/>
            <stroke android:width="1dp" android:color="#8F6B3D"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>
</layer-list>
