<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="2dp">
        <shape android:shape="rectangle"><solid android:color="#8A000000"/><corners android:radius="18dp"/></shape>
    </item>
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#6D4C28" android:centerColor="#C69A55" android:endColor="#60401F"/>
            <corners android:radius="18dp"/>
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#352319" android:centerColor="#1D110C" android:endColor="#100906"/>
            <stroke android:width="1dp" android:color="#D2AA68"/>
            <corners android:radius="15dp"/>
        </shape>
    </item>
</layer-list>
