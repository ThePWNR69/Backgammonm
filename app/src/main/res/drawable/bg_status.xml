<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="1dp" android:top="4dp" android:right="1dp">
        <shape android:shape="rectangle"><solid android:color="#9A000000"/><corners android:radius="19dp"/></shape>
    </item>
    <item android:left="1dp" android:right="1dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#FCE7A8" android:centerColor="#C49B54" android:endColor="#755022"/>
            <corners android:radius="19dp"/>
        </shape>
    </item>
    <item android:left="4dp" android:top="3dp" android:right="4dp" android:bottom="6dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#163D2E" android:centerColor="#0C2A21" android:endColor="#061914"/>
            <stroke android:width="1dp" android:color="#BFE6C986"/>
            <corners android:radius="14dp"/>
        </shape>
    </item>
</layer-list>
