<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="1dp" android:top="2dp" android:right="1dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#7A000000" />
            <corners android:radius="15dp" />
        </shape>
    </item>
    <item android:left="1dp" android:top="0dp" android:right="1dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#F0D79A" android:centerColor="#B9893C" android:endColor="#6E461A" />
            <corners android:radius="15dp" />
        </shape>
    </item>
    <item android:left="3dp" android:top="2dp" android:right="3dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#31B887" android:centerColor="#0E7658" android:endColor="#064431" />
            <stroke android:width="1dp" android:color="#88FFF0C2" />
            <corners android:radius="12dp" />
            <padding android:left="16dp" android:top="3dp" android:right="16dp" android:bottom="3dp" />
        </shape>
    </item>
</layer-list>
