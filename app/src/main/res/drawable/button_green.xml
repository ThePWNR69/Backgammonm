<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="2dp">
        <shape android:shape="rectangle"><solid android:color="#82000000"/><corners android:radius="17dp"/></shape>
    </item>
    <item android:bottom="1dp">
        <shape android:shape="rectangle"><gradient android:angle="270" android:startColor="#FFE7A0" android:centerColor="#D4A14D" android:endColor="#71491B"/><corners android:radius="17dp"/></shape>
    </item>
    <item android:left="3dp" android:top="2dp" android:right="3dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#21B98D" android:centerColor="#087558" android:endColor="#043C2D"/>
            <stroke android:width="1dp" android:color="#F5DB90"/>
            <corners android:radius="13dp"/>
        </shape>
    </item>
</layer-list>
