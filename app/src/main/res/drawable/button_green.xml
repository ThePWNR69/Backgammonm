<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="2dp" android:left="2dp" android:right="2dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="15dp"/>
            <solid android:color="#4A070D0C"/>
        </shape>
    </item>
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="15dp"/>
            <gradient android:angle="270" android:startColor="#1E8A6C" android:centerColor="#0B5B48" android:endColor="#053A31"/>
            <stroke android:width="1.5dp" android:color="#E0BA6A"/>
            <padding android:left="12dp" android:top="4dp" android:right="12dp" android:bottom="4dp"/>
        </shape>
    </item>
</layer-list>
