<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="1dp" android:top="4dp" android:right="1dp">
        <shape android:shape="rectangle"><solid android:color="#A0000000"/><corners android:radius="20dp"/></shape>
    </item>
    <item android:left="1dp" android:right="1dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#FFE3A1" android:centerColor="#C28D40" android:endColor="#754716"/>
            <corners android:radius="20dp"/>
        </shape>
    </item>
    <item android:left="4dp" android:top="3dp" android:right="4dp" android:bottom="7dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#31C696" android:centerColor="#078061" android:endColor="#034B39"/>
            <stroke android:width="1dp" android:color="#A8FFF1C7"/>
            <corners android:radius="15dp"/>
            <padding android:left="14dp" android:top="3dp" android:right="14dp" android:bottom="3dp"/>
        </shape>
    </item>
</layer-list>
