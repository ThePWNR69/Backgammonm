<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="3dp">
        <shape android:shape="rectangle"><solid android:color="#8A000000"/><corners android:radius="16dp"/></shape>
    </item>
    <item android:bottom="3dp">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#5A2F16" android:centerColor="#B77B3F" android:endColor="#4B2814"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="5dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#2A1B13" android:centerColor="#17100C" android:endColor="#0D0907"/>
            <stroke android:width="1.5dp" android:color="#D5AA62"/>
            <corners android:radius="13dp"/>
        </shape>
    </item>
    <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="7dp">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#5E3A2117"/>
            <corners android:radius="11dp"/>
        </shape>
    </item>
</layer-list>
