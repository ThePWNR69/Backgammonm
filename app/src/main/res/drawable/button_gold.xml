<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="1dp" android:top="2dp" android:right="1dp">
        <shape android:shape="rectangle"><solid android:color="#70000000"/><corners android:radius="15dp"/></shape>
    </item>
    <item android:left="1dp" android:right="1dp" android:bottom="2dp">
        <shape android:shape="rectangle"><gradient android:angle="270" android:startColor="#F2DDA6" android:centerColor="#C19147" android:endColor="#704617"/><corners android:radius="15dp"/></shape>
    </item>
    <item android:left="3dp" android:top="2dp" android:right="3dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#6C4C24" android:centerColor="#412A14" android:endColor="#21150C"/>
            <stroke android:width="1dp" android:color="#A8FFE0A1"/>
            <corners android:radius="12dp"/>
        </shape>
    </item>
</layer-list>
